            "ex8c_tab": {
                "with": [
                    "ex8s_tab"
                ],
                "note": "複数の PC を呼ぶ演習。CI では、IP の一覧を自分（127.0.0.1）と、つながらない相手（nonexistent.invalid）にして1台で動かす",
                "override": {
