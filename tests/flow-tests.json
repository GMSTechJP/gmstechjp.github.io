                "expect": [
                    {
                        "debug": "受信データ",
                        "contains": "Hello, World!"
                    }
                ]
            },
            "udp_sample_tab": {
                "note": "inject「3秒ごと」は、配布時は無効（デプロイしただけで送り続けないようにするため）。CI では有効にして、定期送信の経路を確かめる",
                "override": {
                    "udp_inject_periodic": {
                        "d": false
                    }
                },
                "inject": [
                    "ユニキャスト送信",
                    "ブロードキャスト送信",
                    "JSON送信",
                    "JSONでない文字を送る",
                    "エコーを頼む",
                    "3秒ごと"
                ],
                "expect": [
                    {
                        "debug": "受信データ",
                        "contains": "Hello UDP!"
                    },
                    {
                        "debug": "受信データ",
                        "contains": "BROADCAST: Hello everyone!"
                    },
                    {
                        "debug": "送信元情報",
                        "match": "\"ip\":\"127\\.0\\.0\\.1\",\"port\":\\d+,\"data\":\"Hello UDP!\""
                    },
                    {
                        "debug": "JSON データ",
                        "contains": "\"sensor\":\"temp\",\"value\":25.5,\"unit\":\"C\""
                    },
                    {
                        "debug": "JSON データ",
                        "contains": "\"from\":\"127.0.0.1\""
                    },
                    {
                        "debug": "JSON として読めなかったもの",
                        "contains": "hello"
                    },
                    {
                        "debug": "エコー送信",
                        "contains": "[ECHO] Hello"
                    },
                    {
                        "debug": "クライアント側: エコーの返信",
                        "contains": "[ECHO] Hello"
                    },
                    {
                        "debug": "送信データ",
                        "match": "^\\{\"deviceId\":\"sensor-001\",\"temperature\":\\d+(\\.\\d)?,\"humidity\":\\d+,\"timestamp\":\"\\d{4}-\\d{2}-\\d{2}T[^\"]+Z\"\\}$"
                    },
                    {
                        "debug": "受信側: センサーデータ",
                        "contains": "\"deviceId\":\"sensor-001\""
                    }
                ]
            },
