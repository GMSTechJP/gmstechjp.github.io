        "nodered-ftp-sftp-node-guide.html": {
            "tab_ftp_client": {
                "note": "公開の試験用サーバー test.rebex.net（読み取り専用）につなぐ。送信は読み取り専用のため失敗し、catch で受け取る。送るファイル /tmp/reading.csv は用意しない（ガイドの説明どおり、無くても送信を試みて断られる）",
                "inject": [
                    "一覧を要求",
                    "送信を要求",
                    "取得を要求"
                ],
                "expect": [
                    {
                        "debug": "一覧",
                        "contains": "\"name\":\"readme.txt\""
                    },
                    {
                        "debug": "一覧",
                        "contains": "\"name\":\"pub\""
                    },
                    {
                        "debug": "送信の結果",
                        "absent": true
                    },
                    {
                        "debug": "エラー内容",
                        "contains": "\"name\":\"FTP put\""
                    },
                    {
                        "debug": "ファイルの中身",
                        "contains": "Rebex"
                    }
                ],
                "allow_status": {
                    "FTP put": "読み取り専用のサーバーへの送信をわざと失敗させ、catch で受け取ることを確かめるため"
                },
                "external": [
                    "test.rebex.net"
                ],
                "allow_unsafe": true,
                "after": 20
            },
            "tab_ftp_server": {
                "note": "ガイドの curl -T の代わりに、テストの実行役が FTP で送る。演習1は、このタブの ftp server ノード（localhost:7021、camera / change-me）を接続先にしているので、一緒に動かす。ftp server ノードは接続のたびに空のファイルシステムを作るので、フォルダを作る操作は成功する",
                "with": [
                    "tab_ex1"
                ],
                "inject": [
                    "実行"
                ],
                "ftp_uploads": [
                    {
                        "port": 7021,
                        "user": "camera",
                        "password": "change-me",
                        "file": "reading.csv",
                        "body": "temp,25.5\n"
                    },
                    {
                        "port": 7021,
                        "user": "camera",
                        "password": "wrong",
                        "file": "denied.csv",
                        "body": "temp,25.5\n",
                        "refused": true
                    }
                ],
                "expect": [
                    {
                        "debug": "保存したパス",
                        "match": "^/tmp/ftp-received/reading\\.csv$"
                    },
                    {
                        "debug": "認証の記録",
                        "contains": "\"ユーザー名\":\"camera\",\"判定\":\"許可\""
                    },
                    {
                        "debug": "認証の記録",
                        "contains": "\"ユーザー名\":\"camera\",\"判定\":\"拒否\""
                    },
                    {
                        "debug": "結果",
                        "contains": "\"payload\":\"mkdir operation successful.\""
                    },
                    {
                        "debug": "結果",
                        "match": "\"filename\":\"/upload/\\d{4}-\\d{2}-\\d{2}\""
                    }
                ],
                "allow_unsafe": true
            },
            "tab_ex1": {
                "covered_by": "tab_ftp_server"
